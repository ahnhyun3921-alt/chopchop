//

import Foundation

struct Config {
    // Claude API Key
    // https://console.anthropic.com/에서 발급
    static let claudeAPIKey = "YOUR_CLAUDE_API_KEY"

    // Naver API Keys
    // https://console.ncloud.com/에서 발급
    static let naverClientId = "YOUR_NAVER_CLIENT_ID"
    static let naverClientSecret = "YOUR_NAVER_CLIENT_SECRET"
}
