# SafeEat 환경 변수 설정 파일
#
# 사용법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 각 API 키를 실제 값으로 교체
# 3. .env 파일은 절대 Git에 커밋하지 마세요!

# =====================================
# Naver Cloud Platform API Keys
# =====================================

# Naver Maps Client ID (iOS 지도 SDK용)
# 발급: https://console.ncloud.com/ > Application Service > Maps
NAVER_MAPS_CLIENT_ID=your_naver_maps_client_id_here

# Naver API Client ID (검색 API용)
# 발급: https://developers.naver.com/apps/
NAVER_CLIENT_ID=your_naver_api_client_id_here

# Naver API Client Secret (검색 API용)
NAVER_CLIENT_SECRET=your_naver_api_client_secret_here

# =====================================
# Claude API (Anthropic)
# =====================================

# Claude API Key
# 발급: https://console.anthropic.com/ > Settings > API Keys
# 형식: sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
CLAUDE_API_KEY=your_claude_api_key_here

# =====================================
# Firebase (Optional - 수동 설정 필요)
# =====================================

# Firebase 설정은 GoogleService-Info.plist 파일을 통해 자동으로 로드됩니다.
# 추가 환경 변수가 필요한 경우 여기에 추가하세요.

# =====================================
# Development Settings
# =====================================

# API 로깅 활성화 (true/false)
ENABLE_API_LOGGING=true

# 메뉴 분석 캐시 활성화 (true/false)
ENABLE_MENU_CACHE=true

# Claude API 최대 토큰 수
CLAUDE_MAX_TOKENS=2048
